# Haram Pak Website - Environment Variables Example
# Copy this file to .env.local for local development

# Site Configuration (Optional - defaults in lib/constants.ts)
# NEXT_PUBLIC_SITE_NAME="Haram Pak Pvt Ltd"
# NEXT_PUBLIC_WHATSAPP_NUMBER="+923228054660"
# NEXT_PUBLIC_CONTACT_EMAIL="info@harampak.pk"

# For future admin features (not yet implemented)
# DATABASE_URL="postgresql://..."
# NEXTAUTH_SECRET="your-secret-key"
# NEXTAUTH_URL="http://localhost:3000"

# The destination of the Pilgrim Portal button after the separate portal is ready
# NEXT_PUBLIC_PILGRIM_PORTAL_URL="https://portal.harampak.pk"

# Canonical website origin (defaults to https://www.harampak.pk)
# NEXT_PUBLIC_SITE_URL="https://www.harampak.pk"

# Set both to 1 when creating an owner-only static review build.
# HARAM_PAK_STATIC_EXPORT="1"
# NEXT_PUBLIC_PRIVATE_REVIEW="1"

# Portal integration. Server rendering reads only published content.
# PORTAL_CONTENT_ORIGIN="https://portal.harampak.pk"
# NEXT_PUBLIC_PORTAL_INTAKE_ORIGIN="https://portal.harampak.pk"
